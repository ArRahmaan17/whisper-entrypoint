APP_ENV=development
FRONTEND_PORT=3000
BACKEND_PORT=8000
CUDA_IMAGE=nvidia/cuda:13.3.0-runtime-ubuntu24.04
PYTORCH_VERSION=2.12.1
PYTORCH_CUDA_CHANNEL=cu132
POSTGRES_DB=whisper
POSTGRES_USER=whisper
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://whisper:change-me@postgres:5432/whisper
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/data/uploads
OUTPUT_DIR=/data/outputs
MODEL_CACHE_DIR=/data/models
DEFAULT_DEVICE=auto
DEFAULT_ENGINE=openai-whisper
ACCELERATOR_PRIORITY=cuda,rocm,xpu,openvino,mps,cpu
ALLOW_DEVICE_FALLBACK=true
ALLOW_CPU_FALLBACK=false
WORKER_BACKEND=cuda
WORKER_DEVICE_INDEX=
MAX_CONCURRENT_JOBS=1
WORKER_HEARTBEAT_SECONDS=10
WORKER_STALE_AFTER_SECONDS=30
DEVICE_HEALTH_REFRESH_SECONDS=30
MAX_LOADED_MODELS=1
CPU_THREADS=0
MAX_UPLOAD_MB=2048
MAX_CONCURRENT_GPU_JOBS=1
GPU_TEMP_WARN_C=80
GPU_TEMP_STOP_C=87
GPU_MIN_FREE_VRAM_MB=1024
DEFAULT_MODEL=base
DEFAULT_OUTPUT_FORMATS=json,srt,txt
JOB_RETENTION_DAYS=30
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional override. By default Compose allows http://localhost:${FRONTEND_PORT}.
# CORS_ORIGINS=http://localhost:3000
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
ROCM_IMAGE=rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.10.0
XPU_PYTORCH_VERSION=2.11.0
CPU_PYTORCH_VERSION=2.12.1
